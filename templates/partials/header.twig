<div id="login-modal" class="modal" data-error="{{ hasError ? 'true' : 'false' }}">

<div class="modal-content">

<span class="close">&times;</span>

<h2 class="login-modal-title">Connexion</h2>
{% if error %}
<p class="login-error">{{ error }}</p>
{% endif %}

<div class="role-switch">
