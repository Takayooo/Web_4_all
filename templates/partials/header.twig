<header>
<div class="container header-content">

<h1 class="logo">
<a href="index.php?page=1">Web4All.</a>
</h1>

<nav class="nav" aria-label="Navigation principale">
<a href="index.php?page=1" class="nav-link{% if current_page == 'accueil' %} active{% endif %}">Accueil</a>
<a href="offres.php" class="nav-link{% if current_page == 'offres' %} active{% endif %}">Offres</a>
<a href="entreprises.php" class="nav-link{% if current_page == 'entreprises' %} active{% endif %}">Entreprises</a>
{% if user %}
    <a href="dashboard.php" class="nav-link{% if current_page == 'dashboard' %} active{% endif %}">Tableau de bord</a>
{% endif %}
</nav>

<div class="header-actions">
{% if user %}
<div class="user-menu">
    <a href="#" id="user-menu-btn" class="btn btn-white">{{ user.prenom ? user.prenom ~ ' ' ~ user.nom : user.nom }} &#x25BE;</a>
    <div id="user-menu-dropdown" class="user-menu-dropdown" role="menu" aria-label="Menu utilisateur">
        {% if user.role == 'pilote' or user.role == 'administrateur' %}
            <a href="create_account.php" class="user-menu-item"><img src="/assets/ajout.png" alt="Créer un compte" class="menu-icon"> Créer un compte</a>
        {% endif %}
        <a href="parametres.php" class="user-menu-item"><img src="/assets/parametres.png" alt="Paramètres" class="menu-icon"> Paramètres</a>
        <a href="logout.php" class="user-menu-item"><img src="/assets/deconnexion.png" alt="Déconnexion" class="menu-icon"> Se déconnecter</a>
    </div>
</div>
{% else %}
    <a href="#" id="open-login" class="btn btn-white">Se connecter</a>
{% endif %}
</div>

</div>
</header>

<script src="/js/loginmodal.js"></script>
<script src="/js/header.js"></script>
<script src="/js/form-validation.js?v=1"></script>

<div id="login-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="login-modal-title" data-error="{{ hasError ? 'true' : 'false' }}">
<div class="modal-content">
<span class="close">&times;</span>

<h2 id="login-modal-title" class="login-modal-title">Connexion</h2>
{% if error %}
<p class="login-error">{{ error }}</p>
{% endif %}

<form id="login-form" action="login.php" method="POST" class="login-form" novalidate>
<input type="email" name="email" placeholder="Email" autocomplete="email" required>
<input type="password" name="password" placeholder="Mot de passe" autocomplete="current-password" required minlength="4">
<button type="submit">Se connecter</button>
</form>

</div>
</div>
