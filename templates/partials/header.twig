<header>

<div class="container header-content">

<h1 class="logo">
<a href="index.php?page=1">Web4All.</a>
</h1>

<nav class="nav">
<a href="index.php?page=1" class="nav-link">Accueil</a>
<a href="offres.php" class="nav-link">Offres</a>
<a href="entreprises.php" class="nav-link">Entreprises</a>
{% if user %}
    <a href="dashboard.php" class="nav-link">Tableau de bord</a>
{% endif %}
</nav>

<div class="header-actions">


{% if user %}
<a href="logout.php" id="open-logout" class="btn btn-white">Se déconnecter</a>
{% else %}
    <a href="#" id="open-login" class="btn btn-white">Se connecter</a>
{% endif %}

</div>

