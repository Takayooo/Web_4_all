<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Paramètres - Web4All</title>
    <link rel="stylesheet" href="style.css?v=6">
</head>
<body>

{% include 'partials/header.twig' %}

<main class="container">
    <h1>{% if user.role == 'pilote' %}Paramètres - Gestion des comptes{% else %}Paramètres - Mon compte{% endif %}</h1>

    {% if message %}
        <div class="alert alert-success">
            {{ message }}
        </div>
    {% endif %}

    {% if user.role == 'entreprise' %}
        <section>
            <h2>Votre entreprise</h2>
            {% if own %}
                <div class="eleve-card">
                    <h3>{{ own.nom }}</h3>
                    <p>Secteur: {{ own.secteur }}</p>
                    <p>Ville: {{ own.ville }}</p>
                    <p>Email: {{ own.email }}</p>
                    <div class="actions">
                        <button onclick="editEntreprise({{ own.id }}, '{{ own.nom }}', '{{ own.secteur }}', '{{ own.ville }}', '{{ own.email }}')">Modifier</button>
                    </div>
                </div>
            {% else %}
                <p>Votre compte n'a pas été trouvé.</p>
            {% endif %}
        </section>
    {% endif %}
    

    {% if user.role == 'pilote' %}
        <section>
            <h2>Comptes étudiants</h2>
            {% if students %}
                <div class="eleves-list">
                    {% for eleve in students %}
                        <div class="eleve-card">
                            <h3>{{ eleve.prenom }} {{ eleve.nom }}</h3>
                            <p>Email: {{ eleve.email }}</p>
                            <div class="actions">
                                <button onclick="editEleve({{ eleve.id }}, '{{ eleve.nom }}', '{{ eleve.prenom }}', '{{ eleve.email }}')">Modifier</button>
                                <form method="post" style="display: inline;">
                                    <input type="hidden" name="action" value="supprimer">
                                    <input type="hidden" name="id" value="{{ eleve.id }}">
                                    <button type="submit" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce compte ?')">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucun compte étudiant trouvé.</p>
            {% endif %}
        </section>
    {% endif %}
    {%if user.role !='entreprise' %}
        <section>
            <h2>Mon compte</h2>
            {% if own %}
                <div class="eleve-card">
                    {% if user.role == 'entreprise' %}
                        <h3>{{ own.nom }}</h3>
                        <p>Secteur: {{ own.secteur }}</p>
                        <p>Ville: {{ own.ville }}</p>
                        <p>Email: {{ own.email }}</p>
                        <div class="actions">
                            <button onclick="editEntreprise({{ own.id }}, '{{ own.nom }}', '{{ own.secteur }}', '{{ own.ville }}', '{{ own.email }}')">Modifier</button>
                        </div>
                    {% else %}
                        <h3>{{ own.prenom }} {{ own.nom }}</h3>
                        <p>Email: {{ own.email }}</p>
                        <div class="actions">
                            <button onclick="editEleve({{ own.id }}, '{{ own.nom }}', '{{ own.prenom }}', '{{ own.email }}')">Modifier</button>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <p>Votre compte n'a pas été trouvé.</p>
            {% endif %}
        </section>
    {%endif%}


    <!-- Modal pour modification -->
    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2>{% if user.role == 'pilote' %}Modifier le compte{% else %}Modifier mon compte{% endif %}</h2>
            <form method="post">
                <input type="hidden" name="action" value="modifier">
                <input type="hidden" name="id" id="editId">
                <div>
                    <label for="nom">Nom:</label>
                    <input type="text" id="nom" name="nom" required>
                </div>
                {% if user.role == 'entreprise' %}
                    <div>
                        <label for="secteur">Secteur:</label>
                        <input type="text" id="secteur" name="secteur" required>
                    </div>
                    <div>
                        <label for="ville">Ville:</label>
                        <input type="text" id="ville" name="ville" required>
                    </div>
                {% else %}
                    <div>
                        <label for="prenom">Prénom:</label>
                        <input type="text" id="prenom" name="prenom" required>
                    </div>
                {% endif %}
                <div>
                    <label for="email">Email:</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <button type="submit">Enregistrer</button>
            </form>
        </div>
    </div>
</main>

{% include 'partials/footer.twig' %}

<script src="js/modals.js"></script>

</body>
</html>