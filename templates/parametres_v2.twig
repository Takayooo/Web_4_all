<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Paramètres - Web4All</title>
    <link rel="stylesheet" href="style.css?v=9">
</head>
<body>

{% include 'partials/header.twig' %}

<main class="container">
    <h1>
        {% if user.role == 'administrateur' %}
            Paramètres - Administration des comptes
        {% elseif user.role == 'pilote' %}
            Paramètres - Espace pilote
        {% else %}
            Paramètres - Mon compte
        {% endif %}
    </h1>

    {% if message %}
        <div class="alert alert-{{ messageType|default('success') }}">
            {{ message }}
        </div>
    {% endif %}

    <section>
        <h2>Mon compte</h2>
        <div class="eleve-card">
            {% if own.role == 'entreprise' %}
                <h3>{{ own.nom }}</h3>
                <p>Secteur : {{ own.secteur }}</p>
                <p>Ville : {{ own.ville }}</p>
                <p>Note moyenne : {{ own.note }}</p>
                <p>Email : {{ own.email }}</p>
                <div class="actions">
                    <button type="button" onclick="editAccount({{ own.id }}, 'entreprise', '{{ own.nom|e('js') }}', '', '{{ own.email|e('js') }}', '{{ own.secteur|e('js') }}', '{{ own.ville|e('js') }}')">Modifier</button>
                </div>
            {% else %}
                <h3>{{ own.prenom }} {{ own.nom }}</h3>
                <p>Rôle : {{ own.role }}</p>
                <p>Email : {{ own.email }}</p>
                <div class="actions">
                    <button type="button" onclick="editAccount({{ own.id }}, 'standard', '{{ own.nom|e('js') }}', '{{ own.prenom|e('js') }}', '{{ own.email|e('js') }}', '', '')">Modifier</button>
                </div>
            {% endif %}
        </div>
    </section>

    {% if user.role == 'pilote' or user.role == 'administrateur' %}
        <section>
            <h2>Comptes étudiants</h2>
            <form method="get" class="search-form">
                <input type="text" name="search_students" placeholder="Nom, prénom ou email" value="{{ searchStudents|default('') }}">
                <input type="hidden" name="search_enterprises" value="{{ searchEnterprises|default('') }}">
                <input type="hidden" name="search_pilots" value="{{ searchPilots|default('') }}">
                <input type="hidden" name="search_admins" value="{{ searchAdmins|default('') }}">
                <button type="submit">Rechercher</button>
            </form>

            {% if students %}
                <div class="eleves-list">
                    {% for eleve in students %}
                        <div class="eleve-card">
                            <h3>{{ eleve.prenom }} {{ eleve.nom }}</h3>
                            <p>Email : {{ eleve.email }}</p>
                            <div class="actions">
                                <button type="button" onclick="editAccount({{ eleve.id }}, 'standard', '{{ eleve.nom|e('js') }}', '{{ eleve.prenom|e('js') }}', '{{ eleve.email|e('js') }}', '', '')">Modifier</button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucun compte étudiant trouvé.</p>
            {% endif %}
        </section>
    {% endif %}

    {% if user.role == 'pilote' or user.role == 'administrateur' %}
        <section>
            <h2>Entreprises</h2>
            <form method="get" class="search-form">
                <input type="text" name="search_enterprises" placeholder="Nom, secteur, ville ou email" value="{{ searchEnterprises|default('') }}">
                <input type="hidden" name="search_students" value="{{ searchStudents|default('') }}">
                <input type="hidden" name="search_pilots" value="{{ searchPilots|default('') }}">
                <input type="hidden" name="search_admins" value="{{ searchAdmins|default('') }}">
                <button type="submit">Rechercher</button>
            </form>

            {% if enterprises %}
                <div class="eleves-list">
                    {% for entreprise in enterprises %}
                        <div class="eleve-card">
                            <h3>{{ entreprise.nom }}</h3>
                            <p>Secteur : {{ entreprise.secteur }}</p>
                            <p>Ville : {{ entreprise.ville }}</p>
                            <p>Note moyenne : {{ entreprise.note }}</p>
                            <p>Email : {{ entreprise.email }}</p>
                            <div class="actions">
                                {% if user.role == 'administrateur' %}
                                    <button type="button" onclick="editAccount({{ entreprise.id }}, 'entreprise', '{{ entreprise.nom|e('js') }}', '', '{{ entreprise.email|e('js') }}', '{{ entreprise.secteur|e('js') }}', '{{ entreprise.ville|e('js') }}')">Modifier</button>
                                {% endif %}
                                {% if user.role == 'pilote' %}
                                    {% set evaluation = pilotCompanyRatings[entreprise.id]|default(null) %}
                                    <form method="post" class="form-inline">
                                        <input type="hidden" name="action" value="modifier_note">
                                        <input type="hidden" name="id" value="{{ entreprise.id }}">
                                        <label for="note-{{ entreprise.id }}">Ma note</label>
                                        <input type="number" id="note-{{ entreprise.id }}" name="note" min="0" max="5" value="{{ evaluation ? evaluation.note : '' }}" required>
                                        <button type="submit">Enregistrer la note</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucune entreprise trouvée.</p>
            {% endif %}
        </section>
    {% endif %}

    {% if user.role == 'administrateur' %}
        <section>
            <h2>Pilotes</h2>
            <form method="get" class="search-form">
                <input type="text" name="search_pilots" placeholder="Nom, prénom ou email" value="{{ searchPilots|default('') }}">
                <input type="hidden" name="search_students" value="{{ searchStudents|default('') }}">
                <input type="hidden" name="search_enterprises" value="{{ searchEnterprises|default('') }}">
                <input type="hidden" name="search_admins" value="{{ searchAdmins|default('') }}">
                <button type="submit">Rechercher</button>
            </form>

            {% if pilots %}
                <div class="eleves-list">
                    {% for pilote in pilots %}
                        <div class="eleve-card">
                            <h3>{{ pilote.prenom }} {{ pilote.nom }}</h3>
                            <p>Email : {{ pilote.email }}</p>
                            <div class="actions">
                                <button type="button" onclick="editAccount({{ pilote.id }}, 'standard', '{{ pilote.nom|e('js') }}', '{{ pilote.prenom|e('js') }}', '{{ pilote.email|e('js') }}', '', '')">Modifier</button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucun pilote trouvé.</p>
            {% endif %}
        </section>

        <section>
            <h2>Administrateurs</h2>
            <form method="get" class="search-form">
                <input type="text" name="search_admins" placeholder="Nom, prénom ou email" value="{{ searchAdmins|default('') }}">
                <input type="hidden" name="search_students" value="{{ searchStudents|default('') }}">
                <input type="hidden" name="search_enterprises" value="{{ searchEnterprises|default('') }}">
                <input type="hidden" name="search_pilots" value="{{ searchPilots|default('') }}">
                <button type="submit">Rechercher</button>
            </form>

            {% if admins %}
                <div class="eleves-list">
                    {% for admin in admins %}
                        <div class="eleve-card">
                            <h3>{{ admin.prenom }} {{ admin.nom }}</h3>
                            <p>Email : {{ admin.email }}</p>
                            <div class="actions">
                                <button type="button" onclick="editAccount({{ admin.id }}, 'standard', '{{ admin.nom|e('js') }}', '{{ admin.prenom|e('js') }}', '{{ admin.email|e('js') }}', '', '')">Modifier</button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p>Aucun administrateur trouvé.</p>
            {% endif %}
        </section>
    {% endif %}

    <div id="editModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="closeModal()">&times;</span>
            <h2 id="editModalTitle">Modifier le compte</h2>
            <form method="post">
                <input type="hidden" name="action" value="modifier">
                <input type="hidden" name="id" id="editId">
                <div>
                    <label for="nom">Nom</label>
                    <input type="text" id="nom" name="nom" required>
                </div>
                <div id="prenomField">
                    <label for="prenom">Prénom</label>
                    <input type="text" id="prenom" name="prenom">
                </div>
                <div id="secteurField">
                    <label for="secteur">Secteur</label>
                    <input type="text" id="secteur" name="secteur">
                </div>
                <div id="villeField">
                    <label for="ville">Ville</label>
                    <input type="text" id="ville" name="ville">
                </div>
                <div>
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required>
                </div>
                <button type="submit">Enregistrer</button>
            </form>
        </div>
    </div>
</main>

{% include 'partials/footer.twig' %}

<script src="js/modals.js"></script>

</body>
</html>
